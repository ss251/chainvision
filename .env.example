# ChainVision Phase 1 — Testnet-only configuration
# Copy to .env and fill in values. NEVER commit .env or use mainnet private keys.

# Sepolia RPC & local testnet signer (generate locally; fund with Sepolia ETH only)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=
SEPOLIA_ADDRESS=

# Hyperliquid Testnet (API agent key can trade, CANNOT withdraw)
HYPERLIQUID_TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_AGENT_ADDRESS=

# OpenRouter (LLM JSON intent extraction for voice commands)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Telegram Bot & Mini App (create dedicated bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MINIAPP_URL=

# Exchange Testnet Watcher (read-only API keys; Bybit or Binance Futures testnet)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# WalletConnect (Trust Wallet on Sepolia in Telegram Mini App)
WALLETCONNECT_PROJECT_ID=

# Local Speech-to-Text (whisper-server + ggml model)
WHISPER_MODEL_PATH=
WHISPER_PORT=8178

# ChainVision Server
SERVER_PORT=8787
SERVER_PUBLIC_URL=http://127.0.0.1:8787
